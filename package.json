{
  "name": "paper-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build --config local/vite.config.mjs",
    "start": "node --disable-warning=ExperimentalWarning local/server.mjs",
    "typecheck": "tsc --noEmit",
    "archive:import": "node --disable-warning=ExperimentalWarning local/import.mjs",
    "archive:list": "node --disable-warning=ExperimentalWarning local/list.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
